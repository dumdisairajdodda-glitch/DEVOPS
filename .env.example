# Flask Settings
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=super-secret-key-change-this-in-production-123456
PORT=5000

# Database Configuration (MySQL)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/employeehub_db

# Optional: set to 'true' to use local SQLite if MySQL is not available locally
USE_SQLITE=false
