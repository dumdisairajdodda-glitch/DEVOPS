# ========================================================
# 1. FLASK APP & SECURITY SETTINGS
# ========================================================
FLASK_APP=run.py
FLASK_ENV=development
PORT=5000
SECRET_KEY=your-super-secret-key-change-this-in-production

# ========================================================
# 2. DATABASE CREDENTIALS (MYSQL & SQLITE)
# ========================================================
# Set to 'false' to connect to your real MySQL database.
# Set to 'true' for instant, zero-config local runs with SQLite.
USE_SQLITE=true

# MySQL Server Connection Settings
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=employeehub_db

# Full Database URL
DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/employeehub_db

# ========================================================
# 3. INITIAL ADMIN & HR CREDENTIALS (USED BY SEED.PY & UI)
# ========================================================
# Administrator Account
DEFAULT_ADMIN_NAME=System Administrator
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@employeehub.com
DEFAULT_ADMIN_PASSWORD=admin123

# HR Manager Account
DEFAULT_HR_NAME=Sarah Jenkins
DEFAULT_HR_USERNAME=hr_manager
DEFAULT_HR_EMAIL=hr@employeehub.com
DEFAULT_HR_PASSWORD=hr123
